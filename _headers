# Cloudflare Pages headers. The service worker and manifest must not be kept by the CDN or browser cache,
# so updates reach installed apps on their next start.
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache
/offline.html
  Cache-Control: no-cache
/offline
  Cache-Control: no-cache
